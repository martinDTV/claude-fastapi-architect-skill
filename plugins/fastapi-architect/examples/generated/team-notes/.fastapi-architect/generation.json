  "spec": {
    "digest": "b6d1af62ff919334d89a854636e2216e0a35118dba1152682f7639f7c8a374f9",
    "name": "team-notes",
    "schema": "fastapi-architect/spec/1.2"
  },
  "spec_document": {
    "decisions": [
      {
        "id": "ADR-1",
        "rationale": "The workspace claim of the verified token binds the caller to its workspace; the service validates tokens and never stores passwords, sessions or refresh tokens.",
        "status": "accepted",
        "title": "Identity comes from the corporate OIDC provider; the service issues no credentials"
      }
    ],
    "description": "Shared notes of a workspace: every member reads, authors edit their own, admins moderate.",
    "functional": {
      "modules": [
        {
          "description": "Notes written by the members of a workspace and the tags that classify them.",
          "entities": [
            {
              "fields": [
                {
                  "max_length": 120,
                  "name": "title",
                  "type": "str"
                },
                {
                  "max_length": 4000,
                  "name": "body",
                  "type": "str"
                },
                {
                  "default": false,
                  "name": "pinned",
                  "type": "bool"
                }
              ],
              "name": "Note",
              "owned": true
            },
            {
              "fields": [
                {
                  "max_length": 40,
                  "name": "label",
                  "type": "str"
                }
              ],
              "name": "Tag",
              "operations": [
                "create",
                "get",
                "list",
                "delete"
              ]
            }
          ],
          "name": "notes"
        }
      ]
    },
    "name": "team-notes",
    "open_questions": [
      "Should pinned notes be editable by viewers with a dedicated role?"
    ],
    "package": "team_notes",
    "persistence": {
      "kind": "memory"
    },
    "schema": "fastapi-architect/spec/1.2",
    "scope": {
      "data_volume": "small",
      "expected_rps": 20,
      "size": "small",
      "team_size": 3
    },
    "security": {
      "audit": {
        "authorization_decisions": true
      },
      "authentication": "oauth2_jwt",
      "authorization": {
        "model": "roles_and_ownership",
        "operations": {
          "create": [
            "admin",
            "editor"
          ],
          "delete": [
            "admin",
            "editor"
          ],
          "update": [
            "admin",
            "editor"
          ]
        },
        "ownership": {
          "admin_roles": [
            "admin"
          ],
          "visibility": "tenant"
        },
        "roles": [
          "admin",
          "editor",
          "viewer"
        ]
      },
      "multi_tenant": {
        "binding": "principal_claim",
        "enabled": true,
        "strategy": "shared_schema_application_scoping",
        "tenant_param": "workspace_id"
      },
      "oidc": {
        "algorithms": [
          "RS256"
        ],
        "audience": "team-notes-api",
        "claims": {
          "roles": "roles",
          "subject": "sub",
          "tenant": "workspace_id"
        },
        "issuer": "https://login.example.com/",
        "jwks_url": "https://login.example.com/.well-known/jwks.json",
        "leeway_s": 30
      }
    },
    "testing": {
      "coverage_target": 85,
      "levels": [
        "unit",
        "integration"
      ]
    }
  },
  "style": "layered",
  "tool": {
    "name": "fastapi-architect design",
