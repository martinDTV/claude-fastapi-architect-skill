  "spec_document": {
    "decisions": [
      {
        "id": "ADR-1",
        "rationale": "One schema keeps operations simple; the database enforces the tenant boundary for every query the application role runs, in addition to the application scoping and the composite foreign keys.",
        "status": "accepted",
        "title": "Row-level security is the storage boundary between organisations"
      },
      {
        "id": "ADR-2",
        "rationale": "Roles are credentials; the migration verifies that the role exists and cannot bypass RLS, it never creates it with a default password.",
        "status": "accepted",
        "title": "The application role is provisioned outside the migrations"
      }
    ],
    "description": "Projects and tasks of several organisations on one PostgreSQL database, isolated by row-level security.",
    "functional": {
      "modules": [
        {
          "description": "Projects of each organisation.",
          "entities": [
            {
              "fields": [
                {
                  "max_length": 120,
                  "name": "name",
                  "type": "str"
                },
                {
                  "min_value": 0,
                  "name": "budget",
                  "type": "decimal"
                },
                {
                  "name": "starts_on",
                  "type": "date"
                }
              ],
              "name": "Project"
            }
          ],
          "name": "projects"
        },
        {
          "depends_on": [
            "projects"
          ],
          "description": "Tasks inside a project, owned by the member who created them.",
          "entities": [
            {
              "fields": [
                {
                  "name": "project_id",
                  "on_delete": "cascade",
                  "references": "projects.Project",
                  "type": "uuid"
                },
                {
                  "max_length": 200,
                  "name": "title",
                  "type": "str"
                },
                {
                  "default": false,
                  "name": "done",
                  "type": "bool"
                }
              ],
              "name": "Task",
              "owned": true
            }
          ],
          "name": "tasks"
        }
      ]
    },
