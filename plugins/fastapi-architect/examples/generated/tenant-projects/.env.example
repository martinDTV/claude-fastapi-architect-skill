TENANT_PROJECTS_APP_NAME=tenant-projects
TENANT_PROJECTS_ENVIRONMENT=local
TENANT_PROJECTS_API_KEYS={"replace-with-a-generated-key": {"tenant_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "subject": "ops", "roles": ["admin", "member"]}}
# the application connects as the restricted role (no BYPASSRLS, no DDL); migrations run as the owner
TENANT_PROJECTS_DATABASE_URL=postgresql+asyncpg://tenant_projects_app:PASSWORD@localhost:5432/tenant_projects
TENANT_PROJECTS_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://OWNER:PASSWORD@localhost:5432/tenant_projects
TENANT_PROJECTS_APP_ROLE=tenant_projects_app
